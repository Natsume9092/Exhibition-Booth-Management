rules_version = '2';
service cloud.firestore {
    match /databases/{database}/documents {

        // Anyone (even guests, not logged in) can READ data,
        // because guests must be able to browse exhibitions.
        // Only logged-in users can WRITE (create / edit / delete).
        match /{document=**} {
            allow read: if true;
            allow write: if request.auth != null;
        }
    }
}